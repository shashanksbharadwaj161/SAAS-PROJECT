{
  "name": "saas-monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:ada": "npm run dev --workspace=apps/ada-tool",
    "dev:vamp": "npm run dev --workspace=apps/shopify-vamp",
    "build:ada": "npm run build --workspace=apps/ada-tool",
    "build:vamp": "npm run build --workspace=apps/shopify-vamp",
    "type-check": "npm run type-check --workspaces --if-present"
  }
}
