# ============================================================
# ADA Tool — environment variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file with real values.
# ============================================================

# Supabase — ADA Tool project
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Gumroad — get from Gumroad Dashboard → Settings → Advanced
# Seller ID identifies your store; used to verify incoming webhook payloads
GUMROAD_SELLER_ID=YOUR_GUMROAD_SELLER_ID

# Resend — get from Resend Dashboard → API Keys
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Supabase Storage: create a PRIVATE bucket named "ada-pdfs" in
# Supabase Dashboard → Storage. The name is fixed in code (lib/pdf/index.ts).

# Chromium (optional — override the default pack URL if you need a specific version)
# Default: https://github.com/Sparticuz/chromium/releases/download/v123.0.0/chromium-v123.0.0-pack.tar
# CHROMIUM_PACK_URL=

# Gumroad product checkout URLs (get from your Gumroad product pages)
GUMROAD_PRODUCT_BASIC=https://YOURDOMAIN.gumroad.com/l/PRODUCT_ID
GUMROAD_PRODUCT_PREMIUM=https://YOURDOMAIN.gumroad.com/l/PRODUCT_ID
GUMROAD_PRODUCT_MONITORING=https://YOURDOMAIN.gumroad.com/l/PRODUCT_ID

# Anthropic — for plain-English violation descriptions in PDFs (claude-haiku-4-5-20251001)
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
