# ============================================================
# ADA Tool — environment variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file with real values.
# ============================================================

# Supabase — ADA Tool project
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Stripe — get from Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET

# Stripe Price IDs — create in Stripe Dashboard → Products
STRIPE_PRICE_BASIC=price_YOUR_49_DOLLAR_PRICE_ID
STRIPE_PRICE_PRO=price_YOUR_79_DOLLAR_PRICE_ID
STRIPE_PRICE_MONITORING=price_YOUR_149_MONTHLY_PRICE_ID

# Resend — get from Resend Dashboard → API Keys
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Supabase Storage bucket for PDFs
PDF_STORAGE_BUCKET=ada-reports

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
