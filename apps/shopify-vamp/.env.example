# ============================================================
# VAMP Monitor — environment variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file with real values.
# ============================================================

# Supabase — VAMP Monitor project (separate from ADA Tool project)
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_VAMP_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Shopify App credentials
# Get from: Shopify Partners Dashboard → Apps → [Your App] → App Setup
SHOPIFY_API_KEY=YOUR_SHOPIFY_APP_API_KEY
SHOPIFY_API_SECRET=YOUR_SHOPIFY_APP_API_SECRET_KEY
SHOPIFY_SCOPES=read_shopify_payments_disputes,read_orders

# Access token encryption key
# CRITICAL: Generate a strong random key (min 32 chars). Store ONLY in Vercel env vars.
# Used with pgcrypto pgp_sym_encrypt() to encrypt shop access tokens in Supabase.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPIFY_TOKEN_ENCRYPTION_KEY=YOUR_STRONG_RANDOM_ENCRYPTION_KEY_MIN_32_CHARS

# Resend (for merchant breach alert emails)
RESEND_API_KEY=re_YOUR_API_KEY
RESEND_FROM_EMAIL=alerts@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
SHOPIFY_APP_URL=https://your-vamp-app.vercel.app
